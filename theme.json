{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "bira-cream",
          "name": "Cream Canvas",
          "color": "#F8EFDD"
        },
        {
          "slug": "bira-green",
          "name": "BIRA Green",
          "color": "#167529"
        },
        {
          "slug": "bira-ink",
          "name": "Near-Black",
          "color": "#1A1A18"
        },
        {
          "slug": "bira-white",
          "name": "Pure White",
          "color": "#FFFFFF"
        },
        {
          "slug": "bira-sand",
          "name": "Warm Sand",
          "color": "#BD8A5D"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "bira-sans",
          "name": "BIRA Grotesk",
          "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "bira-hand",
          "name": "BIRA Handwritten (accent only)",
          "fontFamily": "\"Caveat\", cursive"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bira-cream)",
      "text": "var(--wp--preset--color--bira-ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--bira-sans)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bira-sans)"
        }
      }
    }
  }
}
